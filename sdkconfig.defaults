# Rust often needs a bit more stack than C examples.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=20000

# Recommended by 'esp-idf-svc', at least if (as we do) 'embassy-time-driver' is being used.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=8192
CONFIG_ESP_TIMER_TASK_STACK_SIZE=4096
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192

# "Increase a bit these stack sizes as they are also a bit too small by default" (not confirmed)
#CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096

# 1 ms granularity for (FreeRTOS) thread sleeps (10 ms by default). (optional)
#CONFIG_FREERTOS_HZ=1000

# Suppress deprecation warnings for legacy drivers still included in bindings (6.1)
CONFIG_I2C_SUPPRESS_DEPRECATE_WARN=y
CONFIG_TWAI_SUPPRESS_DEPRECATE_WARN=y
CONFIG_TOUCH_SUPPRESS_DEPRECATE_WARN=y
